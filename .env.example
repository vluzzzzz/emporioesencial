
# ── Aviso por correo cuando un vendedor registra una venta ──────────────────
# Resend — API Key (re_xxxx)
RESEND_API_KEY=

# A quién le llega el aviso (pueden ser varios, separados por coma).
AVISO_EMAIL_TO=

# Desde qué dirección sale el correo.
# Con onboarding@resend.dev tiene que ser el email dueño de la cuenta Resend.
AVISO_EMAIL_FROM=

# ── Supabase ────────────────────────────────────────────────────────────────
# Settings → API. Son claves públicas (la seguridad la da RLS).
# Estas se pegan en js/supabase-config.js.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Clave de servicio (sb_secret_... en Supabase → Settings → API Keys).
# La usa api/aviso-venta.js para leer la venta y armar el correo.
#
# ES SECRETA: se salta TODAS las reglas de seguridad de la base. Va solo en
# las variables de entorno de Vercel. Nunca en el repositorio, nunca en un
# archivo de la carpeta js/ (esos llegan al navegador de cualquiera).
SUPABASE_SERVICE_ROLE_KEY=
