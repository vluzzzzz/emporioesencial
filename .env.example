
MERCADO_PAGO_ACCESS_TOKEN=

# Mercado Pago — Secret del webhook (Tus integraciones → Webhooks → "Clave secreta").
# Recomendado: con esto seteado se valida la firma y nadie puede falsear notificaciones.
MERCADO_PAGO_WEBHOOK_SECRET=

# Resend — API Key (re_xxxx)
RESEND_API_KEY=

# Email donde llegan las notificaciones de pedido.
# Con onboarding@resend.dev debe ser el email dueño de la cuenta Resend.
NOTIFICATION_EMAIL=

# URL pública del sitio (sin barra final), ej: https://tu-sitio.vercel.app
FRONTEND_URL=

# ── Supabase ────────────────────────────────────────────────────────────────
# Settings → API. Son claves públicas (la seguridad la da RLS).
# Estas se pegan en js/supabase-config.js.
# SUPABASE_URL además se usa del lado server, para guardar los pedidos.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Clave de servicio (sb_secret_... en Supabase → Settings → API Keys).
# La usan api/create-preference.js y api/webhook.js para guardar cada pedido
# en la tabla orders.
#
# ES SECRETA: se salta TODAS las reglas de seguridad de la base. Va solo en
# las variables de entorno de Vercel. Nunca en el repositorio, nunca en un
# archivo de la carpeta js/ (esos llegan al navegador de cualquiera).
SUPABASE_SERVICE_ROLE_KEY=
